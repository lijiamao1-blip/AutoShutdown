<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AutoShutdown.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <!-- PerMonitorV2 DPI 感知（S-UI1）：随 app.manifest 声明，配合 ScrollViewer 自适应布局。
         WFAC010 为 WinForms 分析器建议改用 ApplicationHighDpiMode；本应用是 WPF 优先，
         WinForms 仅用于托盘/对话框，DPI 感知必须在进程启动前由清单建立（WPF 按清单渲染），
         故保留清单声明并显式抑制该分析器。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AutoShutdownDistributionMode)' == 'Production'">
    <DefineConstants>$(DefineConstants);AUTOSHUTDOWN_PRODUCTION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoShutdown.Core\AutoShutdown.Core.csproj" />
    <!-- 引用辅助进程项目：构建时将其 EXE 复制到 App 输出目录，供唯一启动网关按安装目录固定解析 -->
    <ProjectReference Include="..\AutoShutdown.OfficeSaveHelper\AutoShutdown.OfficeSaveHelper.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- S22：Windows 任务计划程序单向同步。TaskScheduler（dahall，MIT）固定 2.12.2：
         纯托管程序集（COM interop 走系统自带组件，无原生依赖），net8.0-windows 兼容，
         单文件发布内嵌，无独立运行时依赖。许可证与发布影响已在 S22 结果记录登记。 -->
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
    <!-- 进程树枚举：托管 WMI（Win32_Process ParentProcessId）读取父子关系，无 P/Invoke。 -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 允许测试项目访问内部清理逻辑（CleanupAfterCancellation / HelperCleanupFailedException）做聚焦回归测试。 -->
    <InternalsVisibleTo Include="AutoShutdown.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 同一份多尺寸 ICO：作为 WPF 资源嵌入，供主窗口/提醒窗口/托盘共用；EXE 图标由 ApplicationIcon 嵌入 -->
    <Resource Include="..\..\assets\icon.ico">
      <Link>assets\icon.ico</Link>
      <LogicalName>assets/icon.ico</LogicalName>
    </Resource>
  </ItemGroup>
</Project>
