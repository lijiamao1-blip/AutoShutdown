<UserControl x:Class="AutoShutdown.App.Controls.SkinThumbnail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False" SnapsToDevicePixels="True">
    <!-- 皮肤缩略图：SkinUri 指向的皮肤字典合并进本控件自身的 Resources（见代码），内部元素全部用
         DynamicResource 取令牌，因此显示的是那套皮肤的颜色，不影响全局。按 900×628 的迷你软件界面
         绘制再整体缩放：顶栏、左侧导航、创建表单卡片、写着 08:30:00 的倒计时卡片。 -->
    <Border x:Name="Frame" CacheMode="BitmapCache">
        <Viewbox Stretch="UniformToFill" StretchDirection="Both">
            <Grid Width="900" Height="628" Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="True">
                <ContentControl ContentTemplate="{DynamicResource SkinBackdropTemplate}" IsHitTestVisible="False" Focusable="False"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                            <Border Width="39" Height="39" CornerRadius="20" BorderThickness="2"
                                    BorderBrush="{DynamicResource LogoRingBorderBrush}" Background="{DynamicResource LogoRingBackgroundBrush}">
                                <TextBlock Text="⏻" FontFamily="Segoe UI Symbol" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource LogoGlyphBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                            <Border Width="210" Height="20" CornerRadius="10" Margin="14,0,20,0" Background="{DynamicResource HeaderTitleBrush}"/>
                            <Border Width="110" Height="30" CornerRadius="15" BorderThickness="1"
                                    Background="{DynamicResource ModeTagBackgroundBrush}" BorderBrush="{DynamicResource ModeTagBorderBrush}">
                                <Border Width="66" Height="10" CornerRadius="5" Background="{DynamicResource ModeTagTextBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource NavBackgroundBrush}" BorderBrush="{DynamicResource NavBorderBrush}" BorderThickness="0,0,1,0">
                            <StackPanel Margin="14,18,14,0">
                                <Border Height="54" CornerRadius="20" Background="{DynamicResource HighlightBrush}" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource NavHomeButtonBorderBrush}" Margin="0,0,0,18">
                                    <Border Width="64" Height="18" CornerRadius="9" Background="{DynamicResource HighlightTextBrush}"/>
                                </Border>
                                <Border Height="14" Width="120" CornerRadius="7" HorizontalAlignment="Left" Margin="14,0,0,22" Background="{DynamicResource NavTextBrush}" Opacity="0.7"/>
                                <Border Height="14" Width="100" CornerRadius="7" HorizontalAlignment="Left" Margin="14,0,0,22" Background="{DynamicResource NavTextBrush}" Opacity="0.7"/>
                                <Border Height="14" Width="128" CornerRadius="7" HorizontalAlignment="Left" Margin="14,0,0,22" Background="{DynamicResource NavTextBrush}" Opacity="0.7"/>
                                <Border Height="14" Width="92" CornerRadius="7" HorizontalAlignment="Left" Margin="14,0,0,22" Background="{DynamicResource NavTextBrush}" Opacity="0.7"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Column="1" Margin="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
                            <!-- 创建任务卡片 -->
                            <Border CornerRadius="20" BorderThickness="2" Padding="18" Background="{DynamicResource GlassFillBrush}" BorderBrush="{DynamicResource GlassBorderBrush}">
                                <StackPanel>
                                    <Border Width="150" Height="20" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Border Width="72" Height="36" CornerRadius="16" Margin="0,0,8,8" Background="{DynamicResource AccentBlueSoftBrush}" BorderThickness="1" BorderBrush="{DynamicResource ChoiceCheckedBorderBrush}"/>
                                        <Border Width="88" Height="36" CornerRadius="16" Margin="0,0,8,8" Background="{DynamicResource ChoiceBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ChoiceBorderBrush}"/>
                                        <Border Width="72" Height="36" CornerRadius="16" Margin="0,0,8,8" Background="{DynamicResource ChoiceBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ChoiceBorderBrush}"/>
                                        <Border Width="88" Height="36" CornerRadius="16" Margin="0,0,8,8" Background="{DynamicResource ChoiceBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ChoiceBorderBrush}"/>
                                    </WrapPanel>
                                    <Border Height="64" CornerRadius="18" Margin="0,0,0,16" Background="{DynamicResource InnerPanelBrush}" BorderThickness="1" BorderBrush="{DynamicResource InnerPanelBorderBrush}">
                                        <Border Height="34" Margin="12,0" CornerRadius="17" Background="{DynamicResource InputBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ComboBorderBrush}"/>
                                    </Border>
                                    <Border Width="120" Height="14" CornerRadius="7" HorizontalAlignment="Left" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.8" Margin="0,0,0,12"/>
                                    <Border Width="200" Height="14" CornerRadius="7" HorizontalAlignment="Left" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.55" Margin="0,0,0,26"/>
                                    <Border Height="44" CornerRadius="16" Background="{DynamicResource AccentBlueBrush}" BorderThickness="2" BorderBrush="{DynamicResource AccentBlueBorderBrush}">
                                        <Border Width="80" Height="14" CornerRadius="7" Background="{DynamicResource PrimaryButtonTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- 当前任务卡片：倒计时是本软件最重要的信息，缩略图里也按真实令牌绘制 -->
                            <Border Grid.Column="2" CornerRadius="20" BorderThickness="2" Padding="20,18" VerticalAlignment="Top"
                                    Background="{DynamicResource GlassFillPurpleBrush}" BorderBrush="{DynamicResource GlassPurpleBorderBrush}">
                                <StackPanel>
                                    <Border Width="130" Height="20" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource AccentCardTitleBrush}" Margin="0,0,0,12"/>
                                    <Border Width="90" Height="12" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource CountdownCaptionBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="08:30:00" FontSize="72" FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                               FontFamily="{DynamicResource CountdownFontFamily}" Foreground="{DynamicResource CountdownTextBrush}"
                                               Effect="{DynamicResource CountdownGlowEffect}"/>
                                    <Border Width="210" Height="12" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource AccentCardTextBrush}" Opacity="0.75" Margin="0,4,0,12"/>
                                    <Border Width="170" Height="12" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource AccentCardTextBrush}" Opacity="0.75" Margin="0,0,0,22"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="120" Height="40" CornerRadius="16" Background="{DynamicResource AccentBlueBrush}" BorderThickness="2" BorderBrush="{DynamicResource AccentBlueBorderBrush}" Margin="0,0,10,0">
                                            <Border Width="70" Height="12" CornerRadius="6" Background="{DynamicResource PrimaryButtonTextBrush}"/>
                                        </Border>
                                        <Border Width="104" Height="40" CornerRadius="16" Background="{DynamicResource DangerSolidBrush}" BorderThickness="1.5" BorderBrush="{DynamicResource DangerSolidBorderBrush}">
                                            <Border Width="58" Height="12" CornerRadius="6" Background="{DynamicResource DangerTextOnSolidBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Border>
</UserControl>
