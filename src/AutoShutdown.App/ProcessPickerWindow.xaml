<Window x:Class="AutoShutdown.App.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:AutoShutdown.App.Presentation"
        Title="从运行中的进程选择关闭目标"
        Width="1080" Height="620" MinWidth="980" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <presentation:InverseBoolConverter x:Key="InverseBoolConverter" />
        <!-- 不可选行标灰 -->
        <Style x:Key="PickerRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selectable}" Value="False">
                    <Setter Property="Foreground" Value="#9AA3B2" />
                    <Setter Property="Background" Value="#F1F3F8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickerCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="IsEnabled" Value="{Binding Selectable}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,14,16,14">
        <!-- 顶栏：搜索 + 刷新 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="搜索：" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBox Width="360" Margin="6,0,10,0" VerticalContentAlignment="Center"
                     Style="{StaticResource InputBoxStyle}"
                     AutomationProperties.Name="搜索进程"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="按进程名、路径、窗口标题、产品名称或公司名称搜索" />
            <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Padding="18,7"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
        </DockPanel>

        <!-- 底栏：说明 + 操作 -->
        <DockPanel DockPanel.Dock="Bottom">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="全部取消" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8"
                        Command="{Binding ClearAllCommand}" Margin="0,0,10,0" />
                <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" Padding="22,8" Margin="0,0,10,0"
                        Click="OnOkClick" />
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8"
                        Click="OnCancelClick" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="这里只读取当前进程信息，不会启动、关闭或结束任何程序。保存后，任务执行时仅按确认过的完整路径匹配。"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,8,4" />
                <TextBlock Text="{Binding WarningText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap"
                           Margin="0,0,8,4" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <!-- 进程表格（参考任务管理器「详细信息」）。作为 DockPanel 最后一个子元素自动填充剩余空间；
             不使用 Dock="Fill"（Fill 不是合法 Dock 枚举值）。行虚拟化保持默认开启：
             数百进程仅实例化视口内行，保证窗口轻量；UIA 自动化经搜索框过滤后定位目标行。 -->
        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowStyle="{StaticResource PickerRowStyle}"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  FontSize="12"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <!-- 选择列：DataGrid 只读时 DataGridCheckBoxColumn 的显示复选框可被点击/切换（视觉），
                     但 TwoWay 绑定不会写回源（IsSelected 保持 false），导致确定时误判为未勾选。
                     改用模板 CheckBox：显示用 OneWay 绑定跟随模型；勾选由 Click 处理器显式写回
                     IsSelected（经 RunningProcessRow.IsSelected 属性变更通知），与 IsReadOnly 无关，
                     键盘空格切换同样触发 Click。 -->
                <DataGridTemplateColumn Header="选择" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      IsEnabled="{Binding Selectable}"
                                      Style="{StaticResource PickerCheckBoxStyle}"
                                      Click="PickerCheck_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="进程名" Binding="{Binding ProcessNameDisplay}" Width="170" />
                <DataGridTextColumn Header="PID" Binding="{Binding PidDisplay}" Width="70" />
                <DataGridTextColumn Header="可执行文件完整路径" Binding="{Binding PathDisplay}" Width="330" />
                <DataGridTextColumn Header="窗口标题" Binding="{Binding WindowTitleDisplay}" Width="180" />
                <DataGridTextColumn Header="产品名称" Binding="{Binding ProductDisplay}" Width="150" />
                <DataGridTextColumn Header="公司名称" Binding="{Binding CompanyDisplay}" Width="140" />
                <DataGridTextColumn Header="状态/不可选原因" Binding="{Binding StatusText}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
