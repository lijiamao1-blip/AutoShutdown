<Window x:Class="AutoShutdown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:AutoShutdown.App.Presentation"
        Title="电脑自动关机助手" Icon="/assets/icon.ico" Width="1080" Height="640" MinWidth="900" MinHeight="580"
        WindowStartupLocation="Manual" Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <presentation:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <presentation:BoolToTextConverter x:Key="BoolToTextConverter" />
        <presentation:HealthBrushConverter x:Key="HealthBrushConverter" />
        <presentation:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <!-- 静态柔光层：不使用动画和高成本模糊 -->
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="100,0,0,-300" Fill="{StaticResource CyanGlowBrush}" IsHitTestVisible="False" />
        <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-260,0" Fill="{StaticResource PurpleGlowBrush}" IsHitTestVisible="False" />
        <Canvas IsHitTestVisible="False" Opacity="0.08">
            <Ellipse Canvas.Left="175" Canvas.Top="118" Width="3" Height="3" Fill="White"/>
            <Ellipse Canvas.Left="332" Canvas.Top="82" Width="2" Height="2" Fill="White"/>
            <Ellipse Canvas.Left="615" Canvas.Top="142" Width="3" Height="3" Fill="#DDF7FF"/>
            <Ellipse Canvas.Right="170" Canvas.Top="108" Width="3" Height="3" Fill="#F7E8FF"/>
            <Ellipse Canvas.Right="92" Canvas.Top="264" Width="2" Height="2" Fill="White"/>
            <Ellipse Canvas.Left="214" Canvas.Bottom="112" Width="2" Height="2" Fill="#E4FBFF"/>
            <Ellipse Canvas.Right="314" Canvas.Bottom="76" Width="3" Height="3" Fill="#F8EAFF"/>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- 顶部状态栏 -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="39" Height="39" CornerRadius="20" BorderBrush="#CCFFFFFF" BorderThickness="2" Background="#20FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="⏻" FontFamily="Segoe UI Symbol" FontSize="27" FontWeight="Bold" Foreground="#24436D" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="电脑自动关机助手" FontSize="21" FontWeight="Bold" Foreground="#20375E" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <Border Grid.Column="2" Style="{StaticResource CapsuleTagStyle}" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding HeaderModeText}" FontSize="12" Foreground="#174B42"/>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderModeHint}" FontSize="12" Foreground="#536985"/>
                        <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="#536985" Opacity="0.8" Margin="18,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="服务运行中" Foreground="#29496F" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Grid.Column="5" Content="⚙  设置" Style="{StaticResource HeaderButtonStyle}" Command="{Binding SettingsCommand}" Margin="0,0,10,0"/>
                    <Button Grid.Column="6" Content="▣  托盘菜单" Style="{StaticResource HeaderButtonStyle}" Command="{Binding TrayMenuCommand}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- 左侧导航（固定宽度，不随内容缩放） -->
                <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}" BorderBrush="#50FFFFFF" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="首页" Style="{StaticResource NavHomeButtonStyle}" Command="{Binding HomeCommand}" Margin="14,18,14,10"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0" Margin="6,-8,6,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}">
                                    <Setter Property="ToolTip" Value="{Binding Title}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PageKey}" Value="home"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontSize="18" Foreground="#315A81" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-3,0,0,0"
                                                   LineHeight="23" LineStackingStrategy="BlockLineHeight"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="17" Foreground="#29496F" VerticalAlignment="Center"
                                                   LineHeight="23" LineStackingStrategy="BlockLineHeight"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="20,0,16,18">
                            <Border Height="1" Background="#35FFFFFF" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding VersionText}" Foreground="#5B7392" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock Text="◉   版本与帮助详见「关于软件」页" Foreground="#5B7392" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区：各页均为可滚动布局（垂直滚动条自动出现），不裁切 -->
                <Grid Grid.Column="1">

                    <!-- 首页（S-UI2：无最外层滚动条；左=创建任务内滚，右上=当前任务，右下=最近活动内滚） -->
                    <Grid Grid.Column="1" Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.06*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="0.94*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：创建定时任务（仅内部滚动，不产生首页最外层滚动条） -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="20,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="创建定时任务" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="时间模式（8 种）" Style="{StaticResource FieldLabelStyle}"/>
                                    <WrapPanel Margin="0,7,0,12">
                                        <RadioButton Content="倒计时" IsChecked="{Binding ModeIsCountdown}" GroupName="TimeMode" Style="{StaticResource SegmentRadioStyle}"/>
                                        <RadioButton Content="今天指定时间" IsChecked="{Binding ModeIsTodayAt}" GroupName="TimeMode" Style="{StaticResource SegmentRadioStyle}"/>
                                        <RadioButton Content="每天固定时间" IsChecked="{Binding ModeIsDailyAt}" GroupName="TimeMode" Style="{StaticResource SegmentRadioStyle}"/>
                                        <RadioButton Content="每周指定星期" IsChecked="{Binding ModeIsWeekdays}" GroupName="TimeMode" Style="{StaticResource SegmentRadioStyle}"/>
                                        <RadioButton Content="下个工作日" IsChecked="{Binding ModeIsNextWorkday}" GroupName="TimeMode" Style="{StaticResource SegmentRadioStyle}"/>
                                        <RadioButton Content="每月第N个工作日" IsChecked="{Binding ModeIsNthWorkdayOfMonth}" GroupName="TimeMode" Style="{StaticResource SegmentRadioStyle}"/>
                                        <RadioButton Content="一次性指定" IsChecked="{Binding ModeIsOneTime}" GroupName="TimeMode" Style="{StaticResource SegmentRadioStyle}"/>
                                        <RadioButton Content="空闲触发" IsChecked="{Binding ModeIsIdle}" GroupName="TimeMode" Style="{StaticResource SegmentRadioStyle}"/>
                                    </WrapPanel>
                                    <Border Style="{StaticResource InnerPanelStyle}" Margin="0,0,0,12">
                                        <Grid>
                                            <StackPanel Visibility="{Binding ModeIsCountdown, Converter={StaticResource BoolToVisibility}}">
                                                <WrapPanel>
                                                    <StackPanel MinWidth="150" Margin="0,0,8,0"><TextBlock Text="小时" Style="{StaticResource MicroLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding CountdownHourOptions}" SelectedItem="{Binding CountdownHoursText}" HorizontalAlignment="Stretch"/></StackPanel>
                                                    <StackPanel MinWidth="150" Margin="4,0"><TextBlock Text="分钟" Style="{StaticResource MicroLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding CountdownMinutesText}" HorizontalAlignment="Stretch"/></StackPanel>
                                                    <StackPanel MinWidth="150" Margin="8,0,0,0"><TextBlock Text="秒" Style="{StaticResource MicroLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding SecondOptions}" SelectedItem="{Binding CountdownSecondsText}" HorizontalAlignment="Stretch"/></StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding IsTimeInputVisible, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Margin="0,0,0,10" Visibility="{Binding IsOneTimeDateVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="执行日期" Style="{StaticResource MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <DatePicker Grid.Column="1" SelectedDate="{Binding OneTimeDate}" DisplayDateStart="{Binding OneTimeDisplayDateStart, Mode=OneWay}"
                                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <DatePicker.CalendarStyle>
                                                                <Style TargetType="Calendar">
                                                                    <Setter Property="FontSize" Value="15"/>
                                                                    <Setter Property="Width" Value="300"/>
                                                                    <Setter Property="Height" Value="264"/>
                                                                </Style>
                                                            </DatePicker.CalendarStyle>
                                                        </DatePicker>
                                                        <Button Grid.Column="2" Content="今天" Style="{StaticResource SecondaryButtonStyle}" Padding="14,4"
                                                                Command="{Binding OneTimeTodayCommand}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding OneTimeDateTimeError}" FontSize="11" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding HasOneTimeDateTimeError, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                                <TextBlock Text="目标时间" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7"/>
                                                <WrapPanel>
                                                    <StackPanel MinWidth="150" Margin="0,0,8,0"><TextBlock Text="小时" Style="{StaticResource MicroLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding ClockHourOptions}" SelectedItem="{Binding TimeHoursText}" HorizontalAlignment="Stretch"/></StackPanel>
                                                    <StackPanel MinWidth="150" Margin="4,0"><TextBlock Text="分钟" Style="{StaticResource MicroLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding TimeMinutesText}" HorizontalAlignment="Stretch"/></StackPanel>
                                                    <StackPanel MinWidth="150" Margin="8,0,0,0"><TextBlock Text="秒" Style="{StaticResource MicroLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding SecondOptions}" SelectedItem="{Binding TimeSecondsText}" HorizontalAlignment="Stretch"/></StackPanel>
                                                </WrapPanel>
                                                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsWeekdaySelectorVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="触发星期（周一至周日，可多选；默认周一至周五）" Style="{StaticResource MicroLabelStyle}" Margin="0,0,0,6"/>
                                                    <WrapPanel>
                                                        <CheckBox Content="周一" IsChecked="{Binding WeekdayMonday}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <CheckBox Content="周二" IsChecked="{Binding WeekdayTuesday}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <CheckBox Content="周三" IsChecked="{Binding WeekdayWednesday}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <CheckBox Content="周四" IsChecked="{Binding WeekdayThursday}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <CheckBox Content="周五" IsChecked="{Binding WeekdayFriday}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <CheckBox Content="周六" IsChecked="{Binding WeekdaySaturday}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <CheckBox Content="周日" IsChecked="{Binding WeekdaySunday}" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsNthWorkdaySelectorVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="每月第几个工作日" Style="{StaticResource MicroLabelStyle}" Margin="0,0,0,6"/>
                                                    <ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding NthWorkdayOptions}" SelectedIndex="{Binding NthWorkdayIndex}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding IsIdleSelectorVisible, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="空闲阈值" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7"/>
                                                <ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding IdleThresholdOptions}" SelectedIndex="{Binding IdleThresholdIndex}" HorizontalAlignment="Stretch"/>
                                                <TextBlock Text="鼠标/键盘持续无操作达到阈值即触发倒计时；倒计时期间输入恢复会自动取消。" FontSize="11" Foreground="#536985" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource InnerPanelStyle}" Margin="0,0,0,12" Visibility="{Binding IsHolidayInputVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="例外日历（节假日）" Style="{StaticResource MicroLabelStyle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="每行一个日期（yyyy-MM-dd），这些日期不执行；留空表示无例外。" FontSize="11" Foreground="#536985" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding HolidayDatesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="电源动作（5 种）" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <RadioButton Content="关机" IsChecked="{Binding ActionIsShutdown}" GroupName="TaskAction" Style="{StaticResource ActionRadioStyle}"/>
                                        <RadioButton Content="重启" IsChecked="{Binding ActionIsRestart}" GroupName="TaskAction" Style="{StaticResource ActionRadioStyle}"/>
                                        <RadioButton Content="睡眠" IsChecked="{Binding ActionIsSleep}" GroupName="TaskAction" Style="{StaticResource ActionRadioStyle}"/>
                                        <RadioButton Content="休眠" IsChecked="{Binding ActionIsHibernate}" GroupName="TaskAction" Style="{StaticResource ActionRadioStyle}"/>
                                        <RadioButton Content="唤醒他机" IsChecked="{Binding ActionIsWakeOnLan}" GroupName="TaskAction" Style="{StaticResource ActionRadioStyle}"/>
                                    </WrapPanel>
                                    <Border Style="{StaticResource InnerPanelStyle}" Margin="0,0,0,12" Visibility="{Binding IsWolTargetSelectorVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="目标机器" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7"/>
                                            <ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding WolTargetsSection.Targets}"
                                                      SelectedValuePath="Id" SelectedValue="{Binding SelectedWolTargetId}"
                                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                            <TextBlock Text="仅向已配置的局域网目标发送 Magic Packet（不扫描、不自动发现、不出公网）。目标机器请在「网络唤醒」或「软件设置」中管理。" FontSize="11" Foreground="#536985" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource InnerPanelStyle}" Margin="0,0,0,12" Visibility="{Binding IsUnattendedTaskOptionVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <CheckBox Content="使用无人值守（到期不等待人工确认）" IsChecked="{Binding UseUnattended}" IsEnabled="{Binding IsUnattendedTaskOptionAvailable}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UnattendedTaskOptionHint}" FontSize="11" Foreground="#536985" TextWrapping="Wrap" Margin="23,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding ReminderOptions}" SelectedIndex="{Binding ReminderIndex}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding ConfigInitErrorText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasConfigInitError, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="初始化安全配置" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding InitializeConfigCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10" Visibility="{Binding IsConfigInitVisible, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding CreateDisabledReason}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasCreateError, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="创建任务" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateCommand}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 右上：当前任务（紧凑状态卡；S-UI2 首页摘要与任务管理一致） -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource GlassCardPurpleStyle}" Padding="20,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="当前任务" Style="{StaticResource CardTitleOnPurpleStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentTaskCountText}" FontSize="12" Foreground="#E9E1FF" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding CurrentStateText}" FontSize="13" FontWeight="SemiBold" Foreground="#294064"/>
                                        <TextBlock Text="{Binding CountdownText}" Margin="0,2,0,4" CacheMode="BitmapCache" TextWrapping="Wrap">
                                            <!-- S-UI1-D2：常规倒计时为 40px 大字白字 + 紫色辉光；空闲任务等待触发（IsIdleStatusVisible）
                                                 时切换为小字号深色换行文本，展示真实空闲时长/阈值，避免长句撑爆卡片。
                                                 辉光放在 Style.Setter 而非元素局部值：WPF 优先级中 Style 触发器高于 Style
                                                 setter，因此 IsIdleStatusVisible 时 Effect={x:Null} 才能真正生效移除辉光；
                                                 若作元素局部值会压过触发器，空闲态仍残留辉光。 -->
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="40"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#B681FF" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIdleStatusVisible}" Value="True">
                                                            <Setter Property="FontSize" Value="15"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="#273A5D"/>
                                                            <Setter Property="Effect" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="下次执行：" FontSize="13" Foreground="Black" Margin="0,3"/><TextBlock Grid.Column="1" Text="{Binding NextFireTimeText}" FontSize="13" Foreground="Black" Margin="0,3" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="任务类型：" FontSize="13" Foreground="Black" Margin="0,3"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaskActionText}" FontSize="13" Foreground="Black" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Text="提前提醒：" FontSize="13" Foreground="Black" Margin="0,3"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WarningTimeText}" FontSize="13" Foreground="Black" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Text="触发方式：" FontSize="13" Foreground="Black" Margin="0,3"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CountdownSourceText}" FontSize="13" Foreground="Black" Margin="0,3"/>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="延迟 10 分钟" Style="{StaticResource SolidBlueButtonStyle}" Command="{Binding SnoozeCommand}" Margin="0,0,8,0"/>
                                        <Button Content="取消任务" Style="{StaticResource DangerSolidButtonStyle}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                                        <Button Content="清除记录" Style="{StaticResource ClearRecordButtonStyle}" Command="{Binding ClearCommand}"/>
                                    </WrapPanel>
                                    <UniformGrid Columns="3" Margin="0,10,0,0">
                                        <Border Background="#9980D0F2" CornerRadius="10" Padding="8,6" Margin="0,0,5,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="任务状态" FontSize="11" FontWeight="SemiBold" Foreground="#29496F" HorizontalAlignment="Center"/><TextBlock Text="{Binding CurrentStateText}" FontSize="11" Foreground="#536985" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" MaxWidth="90"/></StackPanel></Border>
                                        <Border Background="#99B8A8F0" CornerRadius="10" Padding="8,6" Margin="5,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="调度服务" FontSize="11" FontWeight="SemiBold" Foreground="#29496F" HorizontalAlignment="Center"/><TextBlock Text="{Binding SchedulerStatusText}" FontSize="11" Foreground="#536985" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" MaxWidth="90"/></StackPanel></Border>
                                        <Border Background="#9986E0B4" CornerRadius="10" Padding="8,6" Margin="5,0,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="配置状态" FontSize="11" FontWeight="SemiBold" Foreground="#29496F" HorizontalAlignment="Center"/><TextBlock Text="{Binding ConfigStatusText}" FontSize="11" Foreground="#536985" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" MaxWidth="90"/></StackPanel></Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- 右下：最近活动（只使用内部列表滚动，不产生首页最右侧滚动条） -->
                            <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="最近活动" Style="{StaticResource CardTitleStyle}" FontSize="15" Margin="0,0,0,8"/>
                                    <ListBox ItemsSource="{Binding RecentActivities}" Style="{StaticResource ActivityListStyle}" MinHeight="60">
                                        <ListBox.ItemTemplate><DataTemplate><TextBlock Margin="0,3"><Run Text="{Binding Time}" Foreground="#52678A"/><Run Text="   "/><Run Text="{Binding Text}" Foreground="#273A5D"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 任务管理页 -->
                    <ScrollViewer Grid.Column="1" Visibility="{Binding IsTasksPageVisible, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,20,24">

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="任务管理" FontSize="26" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="＋  新建任务" Style="{StaticResource PrimaryButtonStyle}" Padding="22,10" HorizontalAlignment="Right" Command="{Binding HomeCommand}"/>
                            </Grid>

                            <!-- 横幅区：恢复通知 / 仲裁结果 / 强制冲突询问 / 故障状态 -->
                            <StackPanel Margin="0,12,0,0">
                                <Border Style="{StaticResource GlassCardStyle}" Padding="16,10" Margin="0,0,0,8" Visibility="{Binding HasRecoveryNotice, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding RecoveryNoticeText}" FontSize="13" Foreground="#C62828" TextWrapping="Wrap"/>
                                </Border>
                                <Border Style="{StaticResource GlassCardStyle}" Padding="16,10" Margin="0,0,0,8" Visibility="{Binding HasArbitrationDecision, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ArbitrationDecisionText}" FontSize="13" Foreground="#29496F" TextWrapping="Wrap"/>
                                </Border>
                                <Border Style="{StaticResource GlassCardPurpleStyle}" Padding="18,14" Margin="0,0,0,8" Visibility="{Binding HasPendingArbitration, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="多任务同时到期且存在强制冲突，请选择需由调度器执行的胜出任务：" FontSize="14" FontWeight="SemiBold" Foreground="#294064" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding PendingArbitrationItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,0,8" HorizontalAlignment="Left" Style="{StaticResource SolidBlueButtonStyle}"
                                                            Command="{Binding DataContext.ResolveArbitrationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding TaskId}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ActionText}" Margin="0,0,10,0"/>
                                                            <TextBlock Text="{Binding FireTimeText}" Foreground="#536985"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GlassCardStyle}" Padding="16,10" Margin="0,0,0,8" Visibility="{Binding HasSchedulerFault, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SchedulerFaultText}" FontSize="13" Foreground="#C62828" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- 空状态 -->
                            <StackPanel Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" Margin="0,40,0,0">
                                <TextBlock Text="暂无任务" FontSize="22" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="点击右上角「新建任务」创建第一个定时任务。" FontSize="14" Foreground="Black"/>
                            </StackPanel>

                            <!-- 任务列表 -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="18,14" Margin="0,12,0,0" Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                    <ItemsControl ItemsSource="{Binding TaskItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource InnerPanelStyle}" Padding="14,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding ActionText}" FontSize="16" FontWeight="SemiBold" Foreground="#29496F" Margin="0,0,12,0"/>
                                                                <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="#536985" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#536985" TextWrapping="Wrap">
                                                                <Run Text="执行时间 "/><Run Text="{Binding FireTimeText, Mode=OneWay}"/>
                                                                <Run Text="    提醒 "/><Run Text="{Binding WarningText, Mode=OneWay}"/>
                                                                <Run Text="    倒计时 "/><Run Text="{Binding CountdownText, Mode=OneWay}"/>
                                                                <Run Text="    触发 "/><Run Text="{Binding TriggerText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="{Binding EnabledText}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.RowSetEnabledCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanSetEnabled}"/>
                                                            <Button Content="延迟10分钟" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.RowSnoozeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanSnooze}"/>
                                                            <Button Content="停止" Style="{StaticResource DangerSolidButtonStyle}" Padding="14,6" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.RowStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanStop}"/>
                                                            <Button Content="清除" Style="{StaticResource ClearRecordButtonStyle}" Padding="14,6"
                                                                    Command="{Binding DataContext.RowClearCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanClear}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 高级功能页 -->
                    <ScrollViewer Grid.Column="1" Visibility="{Binding IsAdvancedPageVisible, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,20,24">
                            <TextBlock Text="高级功能" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,4"/>
                            <TextBlock Text="以下高风险功能默认关闭；开启需二次确认，并始终受配置双闸门约束。" FontSize="13" Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="无人值守" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding UnattendedRiskText}" FontSize="12" Foreground="#B26A00" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="当前状态：" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding UnattendedStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UnattendedDetailText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding UnattendedErrorText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasUnattendedError, Converter={StaticResource BoolToVisibility}}"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="启用无人值守（双重确认）" Style="{StaticResource DangerSolidButtonStyle}" Command="{Binding EnableUnattendedCommand}" Padding="22,10" Margin="0,0,15,0"/>
                                        <Button Content="撤销授权" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RevokeUnattendedCommand}" Padding="20,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="关机前关闭应用" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="任务到期后先优雅关闭下列目标；强杀默认关闭，须逐目标显式授权（授权即可能丢失未保存工作）。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding CloseAppsTargetInputText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" MinWidth="300" ToolTip="输入可执行文件完整路径或进程 ID（纯正整数按进程 ID，其余按路径）"/>
                                        <Button Content="＋ 添加目标" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCloseAppsTargetCommand}" Padding="20,10"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding CloseAppsTargets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource InnerPanelStyle}" Padding="12,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <CheckBox Content="{Binding Identifier}" IsChecked="{Binding ForceKillAllowed}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="已授权强杀：将立即终止该进程，未保存工作可能丢失。" FontSize="11" Foreground="#C62828" Margin="22,2,0,0"
                                                                       Visibility="{Binding RiskVisible, Converter={StaticResource BoolToVisibility}}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="移除" Style="{StaticResource ClearRecordButtonStyle}" Padding="12,6" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveCloseAppsTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding CloseAppsErrorText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasCloseAppsError, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding CloseAppsStatusText}" FontSize="12" Foreground="#1B7F4B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasCloseAppsStatus, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="保存关闭应用设置" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCloseAppsCommand}" Padding="24,10" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="一次性 RTC 唤醒" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="关机/睡眠/休眠等任务到期前可设置一次性本机唤醒（受控关机前步骤）。能力与失败原因如实显示；不支持或权限不足时不会尝试设置。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="当前状态：" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding RtcStatusSection.StatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RtcStatusSection.DetailText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding RtcStatusSection.ErrorText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding RtcStatusSection.HasError, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="重新查询能力" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RtcStatusSection.RefreshCommand}" Padding="20,8" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Windows 任务计划程序同步" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="把本地任务单向同步到系统「任务计划程序」（AutoShutdown V2 目录），让关机/睡眠/唤醒能绕过本应用自动拉起。任务计划程序里的任务只会回调本应用（--trigger-task），绝不直接执行电源；开启期间自动跟随本地任务增删改。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <CheckBox Content="启用计划任务同步" IsChecked="{Binding TaskSyncSection.Enabled, Mode=TwoWay}" IsEnabled="{Binding TaskSyncSection.CanOperate}"
                                              FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding TaskSyncSection.StatusText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TaskSyncSection.DetailText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,2" Visibility="{Binding TaskSyncSection.DetailText, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding TaskSyncSection.LastSyncText}" FontSize="11" Foreground="#536985" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding TaskSyncSection.LastSyncText, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding TaskSyncSection.ErrorText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding TaskSyncSection.HasError, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="立即同步" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TaskSyncSection.SyncNowCommand}" IsEnabled="{Binding TaskSyncSection.CanOperate}" Padding="20,8" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- S-UI2：Office 文档自动保存（只读说明卡；无开关/立即保存/测试按钮；不改 Office 后端与失败策略） -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Office 文档自动保存" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="关机前自动保存运行中的 Microsoft Word、Excel、PowerPoint 文档（只读说明卡，无开关、无立即保存/测试按钮）。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Text="· 仅支持本机运行中的 Microsoft Word / Excel / PowerPoint；不支持 WPS 或 LibreOffice。&#10;· 仅保存已有路径的文档；从未保存、没有路径的新文档不会自动 SaveAs。&#10;· 程序不会自行启动 Office，也不会在保存后关闭 Office。&#10;· 保存失败或超时会写入「日志与诊断」页的日志（不影响其他步骤）。&#10;· 当前失败策略为 Continue（FailurePolicy=Continue）：即使保存失败也不能承诺阻止关机，请勿依赖它保证数据安全。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="查看日志与诊断" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GoToLogsCommand}" Padding="20,8" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 网络唤醒页 -->
                    <ScrollViewer Grid.Column="1" Visibility="{Binding IsWolPageVisible, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,20,24">
                            <TextBlock Text="网络唤醒" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,4"/>
                            <TextBlock Text="Wake-on-LAN：向局域网内已配置的目标机器发送 Magic Packet，将目标从睡眠/关机状态唤醒。仅局域网、仅显式配置的目标；绝不扫描、不自动发现、不出公网。" FontSize="13" Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="目标机器配置" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="添加要唤醒的局域网目标机器。测试发送只在你逐目标点击时发生；默认清单为空。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,14,8">
                                            <TextBlock Text="机器名称" Style="{StaticResource MicroLabelStyle}"/>
                                            <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding WolTargetsSection.NameInput, UpdateSourceTrigger=PropertyChanged}" MinWidth="150" ToolTip="目标机器名称，用于识别"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,8">
                                            <TextBlock Text="MAC 地址" Style="{StaticResource MicroLabelStyle}"/>
                                            <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding WolTargetsSection.MacInput, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" ToolTip="必填。格式：AA:BB:CC:DD:EE:FF（大写十六进制）"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,8">
                                            <TextBlock Text="广播地址（可选）" Style="{StaticResource MicroLabelStyle}"/>
                                            <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding WolTargetsSection.BroadcastInput, UpdateSourceTrigger=PropertyChanged}" MinWidth="150" ToolTip="可选：IPv4 广播地址（如 192.168.1.255）；留空使用默认有限广播 255.255.255.255。禁止填写公网 IP。"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,8">
                                            <TextBlock Text="UDP 端口（可选）" Style="{StaticResource MicroLabelStyle}"/>
                                            <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding WolTargetsSection.PortInput, UpdateSourceTrigger=PropertyChanged}" MinWidth="90" ToolTip="可选：UDP 端口；留空默认 9（WoL 标准端口）。"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom">
                                            <Button Content="＋ 添加目标" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding WolTargetsSection.AddTargetCommand}" Padding="18,10"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding WolTargetsSection.MacFormatHintText}" FontSize="11" Foreground="#536985" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <TextBlock Text="{Binding WolTargetsSection.ErrorText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding WolTargetsSection.HasError, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding WolTargetsSection.StatusText}" FontSize="12" Foreground="#1B7F4B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding WolTargetsSection.StatusText, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding WolTargetsSection.Targets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource InnerPanelStyle}" Padding="12,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#29496F" Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding Mac}" FontSize="12" Foreground="#536985" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="#536985" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="测试发送" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.WolTargetsSection.TestSendTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="移除" Style="{StaticResource ClearRecordButtonStyle}" Padding="12,6"
                                                                    Command="{Binding DataContext.WolTargetsSection.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="局域网远程控制入口" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="如要让局域网内其他设备远程查看/受控触发本机任务，请前往「软件设置 → 局域网远程控制」配置。默认关闭、默认只读；启用需保存并应用，且默认强制 TLS。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button Content="前往软件设置" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SettingsCommand}" Padding="20,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 日志与诊断页 -->
                    <ScrollViewer Grid.Column="1" Visibility="{Binding IsLogsPageVisible, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,20,24">
                            <TextBlock Text="日志与诊断" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,4"/>
                            <TextBlock Text="查看日志、运行只读安全自检、导出脱敏诊断包或保存当前窗口截图。以下操作均不会修改配置，也不会执行任何电源操作。" FontSize="13" Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- 日志目录与摘要 -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Text="日志目录" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding LogDirectory}" Foreground="#29496F" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button Content="刷新日志" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DiagnosticsCenter.RefreshCommand}" Padding="18,10" Margin="0,0,10,0"/>
                                        <Button Content="复制日志路径" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CopyLogPathCommand}" Padding="18,10" Margin="0,0,10,0"/>
                                        <Button Content="打开日志目录" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DiagnosticsCenter.OpenLogDirectoryCommand}" Padding="18,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 日志查看 -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="日志记录" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                                    <WrapPanel Margin="0,4,0,8">
                                        <TextBlock Text="日志文件" Style="{StaticResource MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding DiagnosticsCenter.LogFileNames}" SelectedItem="{Binding DiagnosticsCenter.SelectedLogFileName}" MinWidth="260" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="级别筛选" Style="{StaticResource MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding DiagnosticsCenter.LevelFilterOptions}" SelectedIndex="{Binding DiagnosticsCenter.LevelFilterIndex}" MinWidth="90" Margin="0,0,16,0" VerticalAlignment="Center"/>
