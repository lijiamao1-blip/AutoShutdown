                                    <CheckBox Content="强制 TLS（明文连接一律拒绝；配对与无人值守等效确认始终要求 TLS）" IsChecked="{Binding RemoteSection.RequireTls, Mode=TwoWay}" IsEnabled="{Binding RemoteSection.CanOperate}"
                                              FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <CheckBox Content="要求客户端出示 TLS 客户端证书（可选项；应用层 HMAC 为主鉴权）" IsChecked="{Binding RemoteSection.RequireClientCertificate, Mode=TwoWay}" IsEnabled="{Binding RemoteSection.CanOperate}"
                                              FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <CheckBox Content="使用导入的 PFX 证书（不勾选则自动生成自签名证书，私钥经 DPAPI 加密落盘）" IsChecked="{Binding RemoteSection.UseImportedCertificate, Mode=TwoWay}" IsEnabled="{Binding RemoteSection.CanOperate}"
                                              FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="20,2,0,8" Visibility="{Binding RemoteSection.UseImportedCertificate, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding RemoteSection.ImportedCertPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="300" ToolTip="导入证书 PFX 完整路径；带密码时密码经 DPAPI 保护的密码文件提供"/>
                                        <TextBlock Text="PFX 路径" FontSize="12" Foreground="#536985" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="远程命令白名单（独立于本地关机前命令白名单，默认仅只读）" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,4"/>
                                    <CheckBox Content="允许查询状态（queryStatus，只读）" IsChecked="{Binding RemoteSection.WhitelistQueryStatus, Mode=TwoWay}" IsEnabled="{Binding RemoteSection.CanOperate}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                    <CheckBox Content="允许任务清单（listTasks，只读）" IsChecked="{Binding RemoteSection.WhitelistListTasks, Mode=TwoWay}" IsEnabled="{Binding RemoteSection.CanOperate}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                    <CheckBox Content="允许远程触发关机（triggerShutdown，高危）" IsChecked="{Binding RemoteSection.WhitelistTriggerShutdown, Mode=TwoWay}" IsEnabled="{Binding RemoteSection.CanOperate}" FontSize="13" Foreground="#C62828" Margin="0,0,0,2"/>
                                    <CheckBox Content="允许远程取消关机（cancelShutdown，高危）" IsChecked="{Binding RemoteSection.WhitelistCancelShutdown, Mode=TwoWay}" IsEnabled="{Binding RemoteSection.CanOperate}" FontSize="13" Foreground="#C62828" Margin="0,0,0,4"/>
                                    <TextBlock Text="配对与设备" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,4"/>
                                    <TextBlock Text="当前 PIN：" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding RemoteSection.PinDisplay, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" Foreground="#B26A00"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RemoteSection.PinExpiryText}" FontSize="11" Foreground="#536985" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                    <TextBlock Text="PIN 每次有效 10 分钟、只可配对一台设备（成功即失效）。配对必须在 TLS 连接上完成。" FontSize="11" Foreground="#536985" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="轮换 PIN" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RemoteSection.RotatePinCommand}" IsEnabled="{Binding RemoteSection.CanOperate}" Padding="18,8"/>
                                        <TextBlock Text="{Binding RemoteSection.LockStatusText}" FontSize="13" Foreground="#C62828" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <Button Content="解除配对锁定" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoteSection.UnlockCommand}" Padding="16,8" Margin="14,0,0,0"
                                                Visibility="{Binding RemoteSection.IsLocked, Converter={StaticResource BoolToVisibility}}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding RemoteSection.DeviceCountText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding RemoteSection.Devices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource InnerPanelStyle}" Padding="12,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold" Foreground="#29496F" Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="#536985" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding PairedAtText}" FontSize="11" Foreground="#536985" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="移除" Style="{StaticResource ClearRecordButtonStyle}" Padding="12,6" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoteSection.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="当前状态：" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0">
                                        <Run Text="{Binding RemoteSection.ServerStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  " /><Run Text="{Binding RemoteSection.StatusText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1B7F4B"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RemoteSection.DetailText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding RemoteSection.DetailText, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding RemoteSection.ErrorText}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding RemoteSection.HasError, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="保存并应用" Style="{StaticResource DangerSolidButtonStyle}" Command="{Binding RemoteSection.SaveCommand}" IsEnabled="{Binding RemoteSection.CanOperate}" Padding="22,10" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 关于软件页 -->
                    <ScrollViewer Grid.Column="1" Visibility="{Binding IsAboutPageVisible, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,20,24">
                            <TextBlock Text="关于软件" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="24,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="46" Height="46" CornerRadius="23" BorderBrush="#CCFFFFFF" BorderThickness="2" Background="#20FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="⏻" FontFamily="Segoe UI Symbol" FontSize="30" FontWeight="Bold" Foreground="#24436D" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductNameText}" FontSize="22" FontWeight="Bold" Foreground="#20375E"/>
                                            <TextBlock Text="定时关机 / 定时任务 / 局域网远程控制" FontSize="12" Foreground="#536985"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Height="1" Background="#35FFFFFF" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="版本" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Grid.Row="1" Text="构建提交" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildCommitText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Text="签名状态" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SigningStatusText}" FontSize="13" Foreground="#B26A00" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Grid.Row="3" Text="数据目录" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DataDirectoryText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Grid.Row="4" Text="日志目录" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LogDirectory}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Grid.Row="5" Text="运行模式" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HeaderModeText}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Grid.Row="6" Text="配置状态" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ConfigStatusText}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="隐私与安全边界" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding PrivacyBoundaryText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="帮助与反馈" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding HelpFeedbackText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
