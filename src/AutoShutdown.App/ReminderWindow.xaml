<Window x:Class="AutoShutdown.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关机前提醒" Icon="/assets/icon.ico" Width="500" Height="300" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True" ShowActivated="False" Background="{DynamicResource ReminderWindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,-150,0" Fill="{DynamicResource ReminderGlowBrush}" IsHitTestVisible="False"/>
        <Border Margin="18" Background="{DynamicResource ReminderCardFillBrush}" BorderBrush="{DynamicResource ReminderCardBorderBrush}" BorderThickness="2" CornerRadius="20" Padding="24"
                Effect="{DynamicResource ReminderCardShadowEffect}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="关机前提醒" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ReminderTitleBrush}"/><Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ReminderButtonStyle}" Click="DismissButton_Click" Padding="8,2"/></Grid>
                <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="13" Foreground="{DynamicResource ReminderMessageBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="CountdownText" Grid.Row="2" FontSize="68" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource CountdownFontFamily}" Foreground="{DynamicResource ReminderCountdownBrush}"
                       Effect="{DynamicResource ReminderCountdownGlowEffect}"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="SnoozeButton" Content="延迟 10 分钟" Style="{StaticResource ReminderButtonStyle}" Click="SnoozeButton_Click"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Content="取消任务" Style="{StaticResource DangerButtonStyle}" Click="CancelButton_Click"/>
                    <Button Grid.Column="4" Content="我知道了" Style="{StaticResource ReminderButtonStyle}" Click="DismissButton_Click"/>
                </Grid>
                <TextBlock x:Name="ErrorText" Grid.Row="4" FontSize="11" Foreground="{DynamicResource ReminderErrorTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,9,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
