<Window x:Class="AutoShutdown.App.ProcessPickerSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认添加运行中的程序目标"
        Width="720" Height="520" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- S-CLOSEUI1-D1：独立窗口必须自带 BoolToVisibility（MainWindow/选择窗的实例资源
             不对外可见；否则摘要窗打开时 StaticResource 解析失败而崩溃）。 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 提示文字 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                       Text="{Binding TitleText}" />
            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="任务执行时只按以下完整路径匹配。不会按进程名自动兜底，也不会自动授予强制结束权限。" />
        </StackPanel>

        <!-- 重新选择模式：原路径 / 新路径 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding ShowOriginalPath, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3">
                <Run Text="原路径："/><Run Text="{Binding OriginalPath, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3">
                <Run Text="新路径："/><Run Text="{Binding NewPathText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="确认替换：将用新路径替换原失效目标。" FontSize="12" Foreground="#B26A00" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 摘要条目 -->
        <TextBlock Grid.Row="2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"
                   Text="{Binding SummaryCountText}" />
        <ScrollViewer x:Name="SummaryItemsScrollViewer" Grid.Row="3" Margin="0,0,0,10"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly" AutomationProperties.Name="待添加程序目标列表">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource InnerPanelStyle}" Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProcessNameDisplay}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding ProcessId, StringFormat=PID {0}}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding PathDisplay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"
                                           ToolTip="{Binding PathDisplay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 窗口标题（仅展示） -->
        <TextBlock Grid.Row="4" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="窗口标题："/><Run Text="{Binding WindowTitlesText, Mode=OneWay}"/>
        </TextBlock>

        <!-- 排除项警告 -->
        <TextBlock Grid.Row="5" Text="{Binding Warnings}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}"/>

        <!-- 底部按钮 -->
        <DockPanel Grid.Row="6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding ConfirmButtonText}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,9" Margin="0,0,10,0"
                        AutomationProperties.Name="{Binding ConfirmButtonText}" Click="OnConfirmClick" />
                <Button Content="返回修改" Style="{StaticResource SecondaryButtonStyle}" Padding="16,9" Margin="0,0,10,0"
                        AutomationProperties.Name="返回修改" Click="OnBackClick" />
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Padding="16,9"
                        AutomationProperties.Name="取消" Click="OnCancelClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
