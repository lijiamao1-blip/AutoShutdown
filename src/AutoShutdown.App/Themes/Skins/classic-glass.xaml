<!--
    经典 · 蓝紫玻璃（classic-glass）——软件原有外观，默认皮肤。

    本文件是皮肤「令牌契约」的唯一事实源：每套皮肤必须定义与本文件完全相同的一组 x:Key，
    且类型一致（画刷可在 SolidColorBrush / LinearGradientBrush / RadialGradientBrush 之间替换；
    DropShadowEffect、FontFamily、DataTemplate、sys:String、sys:Boolean 必须同类型）。
    界面只通过 DynamicResource 引用这些令牌，切换皮肤即替换 Application 资源的第 0 个合并字典。

    本皮肤的取值与令牌化之前逐一相同，外观不得改变。
    主色 #2688EE / #2F80ED，危险色 #D32F2F（实心）/ #E54343（描边），倒计时白字 + #B681FF 紫色辉光。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========== 元数据 ========== -->
    <sys:String x:Key="SkinId">classic-glass</sys:String>
    <sys:String x:Key="SkinDisplayName">经典 · 蓝紫玻璃</sys:String>
    <sys:String x:Key="SkinDescription">软件原有的蓝紫渐变玻璃风格，柔光点缀，清新通透。</sys:String>
    <sys:Boolean x:Key="SkinIsDark">False</sys:Boolean>
    <SolidColorBrush x:Key="SkinPreviewAccentBrush" Color="#2F80ED" />

    <!-- ========== 窗口背景与装饰 ========== -->
    <!-- 主背景：横向蓝紫渐变（参考图基调） -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B6E0FF" Offset="0" />
        <GradientStop Color="#C5D9FC" Offset="0.52" />
        <GradientStop Color="#D8C8F8" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="CyanGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#6543E8FF" Offset="0"/><GradientStop Color="#0043E8FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="PurpleGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#665E63FF" Offset="0"/><GradientStop Color="#005E63FF" Offset="1"/>
    </RadialGradientBrush>

    <!-- 主窗口最底层的背景装饰（静态柔光层：不使用动画和高成本模糊）。
         由 MainWindow 以 ContentControl 承载，IsHitTestVisible=False、CacheMode=BitmapCache。 -->
    <DataTemplate x:Key="SkinBackdropTemplate">
        <Grid>
            <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="100,0,0,-300" Fill="{DynamicResource CyanGlowBrush}" />
            <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-260,0" Fill="{DynamicResource PurpleGlowBrush}" />
            <Canvas Opacity="0.08">
                <Ellipse Canvas.Left="175" Canvas.Top="118" Width="3" Height="3" Fill="White"/>
                <Ellipse Canvas.Left="332" Canvas.Top="82" Width="2" Height="2" Fill="White"/>
                <Ellipse Canvas.Left="615" Canvas.Top="142" Width="3" Height="3" Fill="#DDF7FF"/>
                <Ellipse Canvas.Right="170" Canvas.Top="108" Width="3" Height="3" Fill="#F7E8FF"/>
                <Ellipse Canvas.Right="92" Canvas.Top="264" Width="2" Height="2" Fill="White"/>
                <Ellipse Canvas.Left="214" Canvas.Bottom="112" Width="2" Height="2" Fill="#E4FBFF"/>
                <Ellipse Canvas.Right="314" Canvas.Bottom="76" Width="3" Height="3" Fill="#F8EAFF"/>
            </Canvas>
        </Grid>
    </DataTemplate>

    <!-- ========== 顶栏 ========== -->
    <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#58FFFFFF" Offset="0" />
        <GradientStop Color="#40FFFFFF" Offset="0.52" />
        <GradientStop Color="#48F7F2FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="LogoRingBackgroundBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="LogoRingBorderBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="LogoGlyphBrush" Color="#24436D" />
    <SolidColorBrush x:Key="HeaderTitleBrush" Color="#20375E" />
    <SolidColorBrush x:Key="HeaderHintTextBrush" Color="#536985" />
    <SolidColorBrush x:Key="HeaderStatusTextBrush" Color="#29496F" />
    <!-- 「安全测试模式 / 真实电源模式」胶囊标签 -->
    <SolidColorBrush x:Key="ModeTagBackgroundBrush" Color="#3857E5C5" />
    <SolidColorBrush x:Key="ModeTagBorderBrush" Color="#AA92F6DE" />
    <SolidColorBrush x:Key="ModeTagTextBrush" Color="#174B42" />
    <!-- 顶栏按钮（皮肤 / 设置 / 托盘菜单） -->
    <SolidColorBrush x:Key="HeaderButtonBackgroundBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="HeaderButtonBorderBrush" Color="#66B4C8E6" />
    <SolidColorBrush x:Key="HeaderButtonTextBrush" Color="#29496F" />
    <SolidColorBrush x:Key="HeaderButtonHoverBrush" Color="#32FFFFFF" />
    <SolidColorBrush x:Key="HeaderButtonHoverBorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderButtonPressedBrush" Color="#48FFFFFF" />

    <!-- ========== 左侧导航 ========== -->
    <!-- 导航比内容区更深 -->
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#70D9F2FF" Offset="0" />
        <GradientStop Color="#64D4E8FC" Offset="0.55" />
        <GradientStop Color="#68E0D8FA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavBorderBrush" Color="#50FFFFFF" />
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#33FFFFFF" />
    <!-- 导航选中项与「首页」按钮底色 / 文字 -->
    <SolidColorBrush x:Key="HighlightBrush" Color="#2688EE" />
    <SolidColorBrush x:Key="HighlightTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavHomeButtonBorderBrush" Color="#D8FFFFFF" />
    <SolidColorBrush x:Key="NavIconBrush" Color="#315A81" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#29496F" />
    <!-- 导航选中项（底色为 HighlightBrush）上的图标与文字 -->
    <SolidColorBrush x:Key="NavSelectedIconBrush" Color="#315A81" />
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#29496F" />
    <SolidColorBrush x:Key="NavDividerBrush" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="NavFooterTextBrush" Color="#5B7392" />

    <!-- ========== 卡片 ========== -->
    <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C8FFFFFF" Offset="0" />
        <GradientStop Color="#BFFFFFFF" Offset="0.52" />
        <GradientStop Color="#B8F8FAFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#E8FFFFFF" />
    <!-- 强调卡片（首页「当前任务」、仲裁询问） -->
    <LinearGradientBrush x:Key="GlassFillPurpleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C8FFFFFF" Offset="0" />
        <GradientStop Color="#BFF9F5FF" Offset="0.52" />
        <GradientStop Color="#B8F0E9FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassPurpleBorderBrush" Color="#EEFFFFFF" />
    <SolidColorBrush x:Key="AccentCardTitleBrush" Color="#20345F" />
    <SolidColorBrush x:Key="AccentCardTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="AccentCardEmphasisBrush" Color="#294064" />
    <!-- 轻量阴影 -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.10"
                      Color="#2040A0" />
    <!-- 卡片内的浅色分组面板（输入区、列表行） -->
    <SolidColorBrush x:Key="InnerPanelBrush" Color="#72FFFFFF" />
    <SolidColorBrush x:Key="InnerPanelBorderBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#35FFFFFF" />
    <!-- 首页三张状态小卡 -->
    <SolidColorBrush x:Key="StatusCardCyanBrush" Color="#9980D0F2" />
    <SolidColorBrush x:Key="StatusCardBlueBrush" Color="#99B8A8F0" />
    <SolidColorBrush x:Key="StatusCardGreenBrush" Color="#9986E0B4" />
    <SolidColorBrush x:Key="StatusCardTitleBrush" Color="#29496F" />
    <SolidColorBrush x:Key="StatusCardValueBrush" Color="#536985" />
    <!-- 「每月第几个上班日」说明框 -->
    <SolidColorBrush x:Key="InfoBoxBackgroundBrush" Color="#EAF4FF" />
    <SolidColorBrush x:Key="InfoBoxBorderBrush" Color="#A9CFF7" />
    <SolidColorBrush x:Key="InfoBoxTitleBrush" Color="#1D5FA7" />
    <SolidColorBrush x:Key="InfoBoxTextBrush" Color="#425D7A" />
    <SolidColorBrush x:Key="InfoBoxEmphasisBrush" Color="#174F8C" />

    <!-- ========== 文字 ========== -->
    <!-- 直接位于窗口背景上的页面标题与说明 -->
    <SolidColorBrush x:Key="PageTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C2740" />
    <!-- 未单独指定颜色的文字（窗口默认前景）与下拉框选中值 -->
    <SolidColorBrush x:Key="DefaultTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="ComboTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#43536F" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6B8C" />
    <SolidColorBrush x:Key="TextHintBrush" Color="#536985" />
    <SolidColorBrush x:Key="TextEmphasisBrush" Color="#29496F" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#F4F7FF" />
    <SolidColorBrush x:Key="ProductTitleBrush" Color="#20375E" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#C62828" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#1B7F4B" />
    <SolidColorBrush x:Key="ActivityTimeBrush" Color="#52678A" />
    <SolidColorBrush x:Key="ActivityTextBrush" Color="#273A5D" />

    <!-- ========== 分段选择（时间模式 / 电源动作） ========== -->
    <SolidColorBrush x:Key="ChoiceBackgroundBrush" Color="#A8FFFFFF" />
    <SolidColorBrush x:Key="ChoiceBorderBrush" Color="#666A7EB6" />
    <SolidColorBrush x:Key="ChoiceHoverBorderBrush" Color="#2688EE" />
    <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#E62F80ED" />
    <SolidColorBrush x:Key="ChoiceCheckedBorderBrush" Color="#9FD7FF" />
    <SolidColorBrush x:Key="ChoiceCheckedTextBrush" Color="#FFFFFF" />

    <!-- ========== 按钮 ========== -->
    <!-- 统一操作蓝：与"倒计时"选中态同源（主色 #2F80ED），创建任务 / 延迟10分钟 复用 -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#2F80ED" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#3D8BF0" />
    <SolidColorBrush x:Key="AccentBluePressedBrush" Color="#2568C8" />
    <SolidColorBrush x:Key="AccentBlueBorderBrush" Color="#1E5FB8" />
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF" />
    <!-- 次级按钮：描边 -->
    <SolidColorBrush x:Key="SecondaryButtonTextBrush" Color="#2688EE" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#2688EE" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#182F80ED" />
    <SolidColorBrush x:Key="SubtleButtonHoverBrush" Color="#142F80ED" />
    <!-- 危险操作（取消任务 / 停止 / 停止执行 / 一键清除）：必须是明确的红色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#E54343" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#18E5484D" />
    <SolidColorBrush x:Key="DangerSolidBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="DangerSolidHoverBrush" Color="#E53935" />
    <SolidColorBrush x:Key="DangerSolidPressedBrush" Color="#C62828" />
    <SolidColorBrush x:Key="DangerSolidBorderBrush" Color="#B71C1C" />
    <SolidColorBrush x:Key="DangerTextOnSolidBrush" Color="#FFFFFF" />

    <!-- ========== 输入框 / 下拉框 / 浮层 ========== -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#66435A9C" />
    <SolidColorBrush x:Key="ComboBorderBrush" Color="#80B4C8E6" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#2688EE" />
    <SolidColorBrush x:Key="ComboArrowBrush" Color="#536985" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#F8FFFFFF" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#662688EE" />
    <DropShadowEffect x:Key="PopupShadowEffect" BlurRadius="12" ShadowDepth="2" Opacity="0.10" />
    <!-- 悬停提示胶囊（皮肤画廊卡片上方显示皮肤名） -->
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#F2161A22" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="InputCaretBrush" Color="#000000" />

    <!-- ========== 系统控件（Themes/SkinSystemControls.xaml 的隐式样式使用） ==========
         经典皮肤不合并 SkinSystemControls.xaml（滚动条、复选框、表格等保持 Windows 默认外观），
         以下取值仅为保持令牌契约完整；其他皮肤必须合并该文件并给出与自身配色一致的取值。 -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#808A97B3" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#B05A6B8C" />
    <SolidColorBrush x:Key="ListRowHoverBrush" Color="#262F80ED" />
    <SolidColorBrush x:Key="ListRowSelectedBrush" Color="#402F80ED" />
    <SolidColorBrush x:Key="ListRowSelectedTextBrush" Color="#1C2740" />
    <SolidColorBrush x:Key="CheckBoxBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#8A97B3" />
    <SolidColorBrush x:Key="CheckBoxCheckedBackgroundBrush" Color="#2F80ED" />
    <SolidColorBrush x:Key="CheckBoxGlyphBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="#F6F8FC" />
    <SolidColorBrush x:Key="DataGridLineBrush" Color="#E1E6EF" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="DataGridHeaderTextBrush" Color="#1C2740" />

    <!-- ========== 日期选择日历 ==========
         下拉日历的标题、星期行沿用 Windows 默认深色文字，所以每套皮肤的日历都必须是浅色表面。 -->
    <SolidColorBrush x:Key="CalendarBackgroundBrush" Color="#F8FBFF" />
    <SolidColorBrush x:Key="CalendarBorderBrush" Color="#98C4F5" />
    <SolidColorBrush x:Key="CalendarDayTextBrush" Color="#243B5A" />
    <SolidColorBrush x:Key="CalendarInactiveDayTextBrush" Color="#A2AEC0" />
    <SolidColorBrush x:Key="CalendarTodayBorderBrush" Color="#2F80ED" />
    <SolidColorBrush x:Key="CalendarTodayTextBrush" Color="#1B63C6" />
    <SolidColorBrush x:Key="CalendarHoverBrush" Color="#DCEEFF" />
    <SolidColorBrush x:Key="CalendarSelectedBrush" Color="#2F80ED" />
    <SolidColorBrush x:Key="CalendarSelectedBorderBrush" Color="#1D68C9" />
    <SolidColorBrush x:Key="CalendarSelectedTextBrush" Color="#FFFFFF" />

    <!-- ========== 倒计时（首页大字 / 任务行 / 提醒窗口） ========== -->
    <FontFamily x:Key="CountdownFontFamily">Microsoft YaHei UI</FontFamily>
    <SolidColorBrush x:Key="CountdownTextBrush" Color="#FFFFFF" />
    <DropShadowEffect x:Key="CountdownGlowEffect" Color="#B681FF" BlurRadius="12" ShadowDepth="0" Opacity="0.55" />
    <!-- 紧急态：提醒中且剩余 ≤ 60 秒 -->
    <SolidColorBrush x:Key="CountdownUrgentBrush" Color="#B3261E" />
    <DropShadowEffect x:Key="CountdownUrgentGlowEffect" Color="#FFFFFF" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
    <!-- 倒计时上方的状态行、卡片右上角的任务计数、空闲任务等待中的小字说明 -->
    <SolidColorBrush x:Key="CountdownCaptionBrush" Color="#294064" />
    <SolidColorBrush x:Key="CountdownBadgeBrush" Color="#E9E1FF" />
    <SolidColorBrush x:Key="CountdownIdleTextBrush" Color="#273A5D" />

    <!-- ========== 关机前提醒窗口（置顶小窗） ========== -->
    <LinearGradientBrush x:Key="ReminderWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B6E0FF" Offset="0" />
        <GradientStop Color="#C5D9FC" Offset="0.52" />
        <GradientStop Color="#D8C8F8" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="ReminderGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#665E63FF" Offset="0"/><GradientStop Color="#005E63FF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ReminderCardFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C8FFFFFF" Offset="0" />
        <GradientStop Color="#BFF9F5FF" Offset="0.52" />
        <GradientStop Color="#B8F0E9FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ReminderCardBorderBrush" Color="#F2FFFFFF" />
    <DropShadowEffect x:Key="ReminderCardShadowEffect" Color="#30206C" BlurRadius="20" ShadowDepth="4" Opacity="0.45" />
    <SolidColorBrush x:Key="ReminderTitleBrush" Color="#1C2740" />
    <SolidColorBrush x:Key="ReminderMessageBrush" Color="#43536F" />
    <SolidColorBrush x:Key="ReminderCountdownBrush" Color="#FFFFFF" />
    <DropShadowEffect x:Key="ReminderCountdownGlowEffect" Color="#C985FF" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />
    <SolidColorBrush x:Key="ReminderCountdownUrgentBrush" Color="#B3261E" />
    <DropShadowEffect x:Key="ReminderCountdownUrgentGlowEffect" Color="#FFFFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
    <SolidColorBrush x:Key="ReminderErrorTextBrush" Color="#FFD3D8" />

    <!-- ========== 进程选择窗口 ========== -->
    <SolidColorBrush x:Key="PickerDisabledRowTextBrush" Color="#9AA3B2" />
    <SolidColorBrush x:Key="PickerDisabledRowBackgroundBrush" Color="#F1F3F8" />

</ResourceDictionary>
