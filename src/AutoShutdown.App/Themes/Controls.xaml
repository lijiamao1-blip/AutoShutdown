<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 玻璃卡片 -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
    </Style>

    <Style x:Key="NavHomeButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border Background="#2688EE" BorderBrush="#D8FFFFFF" BorderThickness="1.5" CornerRadius="20">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="ComingSoonTagStyle" TargetType="Border">
        <Setter Property="Background" Value="#20FFFFFF"/><Setter Property="BorderBrush" Value="#65FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="InnerPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#72FFFFFF"/><Setter Property="BorderBrush" Value="#70FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style x:Key="MicroLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="2,0,0,4"/>
    </Style>

    <!-- 分段选择与动作选择：用原生 RadioButton 实现按钮式单选 -->
    <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ChoiceBorder"
                            MinHeight="38"
                            Padding="12,7"
                            CornerRadius="16"
                            Background="#A8FFFFFF"
                            BorderBrush="#666A7EB6"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource AccentBlueSoftBrush}" />
                            <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#FF9FD7FF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionRadioStyle"
           TargetType="RadioButton"
           BasedOn="{StaticResource SegmentRadioStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="GlassCardPurpleStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="Background" Value="{StaticResource GlassFillPurpleBrush}" />
        <Setter Property="BorderBrush" Value="#EEFFFFFF"/>
    </Style>

    <Style x:Key="CardTitleOnPurpleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#20345F"/>
    </Style>

    <!-- 胶囊标签 -->
    <Style x:Key="CapsuleTagStyle" TargetType="Border">
        <Setter Property="Background" Value="#3857E5C5" />
        <Setter Property="BorderBrush" Value="#AA92F6DE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style x:Key="StatusCardBaseStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="Padding" Value="9"/><Setter Property="MinHeight" Value="108"/>
    </Style>
    <Style x:Key="StatusCardCyanStyle" TargetType="Border" BasedOn="{StaticResource StatusCardBaseStyle}"><Setter Property="Background" Value="#9980D0F2"/></Style>
    <Style x:Key="StatusCardBlueStyle" TargetType="Border" BasedOn="{StaticResource StatusCardBaseStyle}"><Setter Property="Background" Value="#99B8A8F0"/></Style>
    <Style x:Key="StatusCardGreenStyle" TargetType="Border" BasedOn="{StaticResource StatusCardBaseStyle}"><Setter Property="Background" Value="#9986E0B4"/></Style>
    <Style x:Key="IconCircleBaseStyle" TargetType="Border"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="20"/><Setter Property="BorderBrush" Value="#E8FFFFFF"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    <Style x:Key="CyanIconCircleStyle" TargetType="Border" BasedOn="{StaticResource IconCircleBaseStyle}"><Setter Property="Background" Value="#80D0F2"/></Style>
    <Style x:Key="BlueIconCircleStyle" TargetType="Border" BasedOn="{StaticResource IconCircleBaseStyle}"><Setter Property="Background" Value="#B8A8F0"/></Style>
    <Style x:Key="GreenIconCircleStyle" TargetType="Border" BasedOn="{StaticResource IconCircleBaseStyle}"><Setter Property="Background" Value="#86E0B4"/></Style>
    <Style x:Key="StatusIconTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="StatusTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    <Style x:Key="StatusValueStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,4,0,0"/></Style>

    <!-- 主按钮：统一操作蓝实心（与"倒计时"选中态同源 #2F80ED） -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource AccentBlueBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="16">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlueHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBluePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 实心蓝按钮（"延迟 10 分钟"用）：复用 PrimaryButtonStyle，仅保留原有紧凑内边距 -->
    <Style x:Key="SolidBlueButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <!-- 次级按钮：蓝色描边（边框加粗至 2px，内边距加大，改善浅色背景上的可辨识度） -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource HighlightBrush}"
                            BorderThickness="2"
                            CornerRadius="16">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#182F80ED" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险按钮：红色描边 -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1.5"
                            CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#18E5484D" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险按钮（实心深红）：供"取消任务"使用，不应用给普通按钮 -->
    <Style x:Key="DangerSolidButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DangerSolidBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource DangerSolidBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSolidHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSolidPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 弱化文字按钮（清除记录用） -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#142F80ED" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#29496F"/><Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="HeaderButtonBorder" Background="#99FFFFFF" BorderBrush="#66B4C8E6" BorderThickness="1" CornerRadius="10">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderButtonBorder" Property="Background" Value="#32FFFFFF"/><Setter TargetName="HeaderButtonBorder" Property="BorderBrush" Value="White"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderButtonBorder" Property="Background" Value="#48FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LightOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,9"/>
    </Style>
    <Style x:Key="SubtleOnDarkButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Foreground" Value="#C9D4F2"/>
    </Style>

    <!-- 清除记录专用按钮：浅色玻璃卡片上的弱化文字按钮（替代误用于浅底的 SubtleOnDarkButtonStyle） -->
    <Style x:Key="ClearRecordButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- 提醒窗口专用按钮：实心蓝 + 白字，浅色玻璃背景上对比充分（替代 LightOutlineButtonStyle 在提醒窗口的误用） -->
    <Style x:Key="ReminderButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <!-- 导航项 -->
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="16"
                            Margin="8,5">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HighlightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource HighlightTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavItemHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片标题 -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 卡片字段标签 -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- 输入框 -->
    <Style x:Key="InputBoxStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#CCFFFFFF" />
        <Setter Property="BorderBrush" Value="#66435A9C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉框 -->
    <Style x:Key="InputComboStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#CCFFFFFF" />
        <Setter Property="BorderBrush" Value="#80B4C8E6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ComboBorder"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            MinHeight="36"
                                            CornerRadius="20">
                                        <Grid Margin="12,0,10,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                            <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="⌄" FontSize="15" Foreground="#536985" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#2688EE"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Background="#F8FFFFFF" BorderBrush="#662688EE" BorderThickness="1" CornerRadius="12" Padding="4">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.10"/></Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 最近活动列表 -->
    <Style x:Key="ActivityListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="ActivityItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
